{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hopper": {
      "type": "streamable-http",
      "url": "https://withhopper.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "account:read",
              "keys:write",
              "audio"
            ]
          }
        }
      }
    }
  }
}
